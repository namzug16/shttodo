# Copy this file to .env and set the values. Do not commit .env.
# Docker Compose reads .env automatically. For `shttodo serve` without Docker, run: set -a; . ./.env; set +a

# Required. Refer to "Get the tokens" in README.md.
SHTTODO_API_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional. These are the defaults.
REMINDER_INTERVAL_MINUTES=60
REMINDER_ACTIVE_HOURS=09-21
TZ=UTC

# Optional. An agent command writes the reminder text. Empty means the plain list.
# Refer to docs/reminder-agent.md. Use single quotes.
# REMINDER_AGENT_COMMAND='codex exec -m gpt-6-luna -c model_reasoning_effort=low --sandbox read-only --skip-git-repo-check --ephemeral -'
# REMINDER_AGENT_PROMPT='Write a short reminder. Plain text only.'

# Docker Compose only: the localhost port on the host.
SHTTODO_HOST_PORT=3101

# `shttodo serve` without Docker only. Docker Compose does not send these to the container.
# SHTTODO_DATABASE_PATH=shttodo.db
# SHTTODO_LISTEN_ADDRESS=:8080

# CLI only: the server URL. The CLI also uses SHTTODO_API_TOKEN.
# SHTTODO_SERVER_URL=http://127.0.0.1:3101
